# ---------------------------------------------------------------------------
# JordanClawMax environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# URL of the local bridge server (see bridge-server/). This runs inside WSL,
# next to the real OpenClaw install/ffmpeg/whisper, and is what actually
# drives the JordanClawMax agent skill. OpenClaw itself has no REST API -
# there is no api.openclaw.ai/gateway.openclaw.ai to point this at.
REACT_APP_BRIDGE_URL=http://localhost:8787

# Optional: override the poll interval (ms) used while waiting on a job
REACT_APP_OPENCLAW_POLL_INTERVAL_MS=5000

# Optional: override the max time (ms) to keep polling before timing out.
# Keep this comfortably above the bridge server's own BRIDGE_MAX_TOTAL_MS
# (default 30 min) so the frontend doesn't time out independently right as
# the bridge is about to report completion - see bridge-server/README.md.
REACT_APP_OPENCLAW_POLL_TIMEOUT_MS=3600000
